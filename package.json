{
  "name": "jev-search-mcp",
  "version": "0.1.0",
  "description": "Jev Search as an MCP server and CLI: plain-language web search with sources and time window chosen by Jev, results ranked by relevance. Zero runtime dependencies.",
  "type": "module",
  "bin": {
    "jev-search-mcp": "./src/cli.js"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test 'test/*.test.js'",
    "smoke": "node scripts/smoke.js",
    "validate": "claude plugin validate ."
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-search",
    "search",
    "jev",
    "search1api",
    "claude-code",
    "codex"
  ],
  "homepage": "https://github.com/mukiwu/jev-search-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mukiwu/jev-search-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mukiwu/jev-search-mcp/issues"
  },
  "author": "Muki Wu (https://github.com/mukiwu)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
